# Copy to api/.env and set real local values. Keep this file secret-free.
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca

# Database used by the PHP API.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lucebianca
DB_USER=lucebianca_app
DB_PASS=CHANGE_ME

# Required for customer/admin JWTs and CSRF tokens. Generate a random secret
# of at least 32 characters; leave blank until you have generated one.
JWT_SECRET=
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated IPs/CIDRs allowed to supply X-Forwarded-For for rate
# limiting (e.g. "10.0.0.1, 172.16.0.0/12"). Empty = never trust the header
# (fail-closed, direct-connection default).
TRUSTED_PROXIES=

# Storefront URL used in email links.
SITE_URL=http://localhost:3000

# Optional integrations. Leave unset until configured.
RATE_LIMIT_STORAGE_DIR=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only if card payments are enabled and the CMI integration is ready.
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_HASH_KEY=
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
# Server-to-server endpoint CMI notifies (POST). The customer never sees it.
CMI_CALLBACK_URL=
# Customer-facing return base (storefront payment page, e.g.
# https://lucebianca.co/payment). CMI redirects the customer's browser to
# {CMI_RETURN_URL}/{orderId}?token=...&pay=success|failure after 3-D Secure.
# Falls back to SITE_URL + /payment when empty. Must differ from CMI_CALLBACK_URL.
CMI_RETURN_URL=

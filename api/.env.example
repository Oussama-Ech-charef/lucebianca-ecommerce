# Luce Bianca API — environment template
# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lucebianca
DB_USER=root
DB_PASS=

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600          # access token lifetime
JWT_REFRESH_TTL_SECONDS=604800 # refresh token lifetime (7 days)

# Google Sign-In (OAuth 2.0 / Google Identity Services). Public client id —
# also served to the browser as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave empty to
# disable the Google button on /login and /register.
GOOGLE_CLIENT_ID=

# Email verification (phase 16) — transactional mail via Resend's REST API.
# RESEND_FROM_EMAIL uses Resend's shared onboarding@resend.dev sender on the
# free tier; replace with a verified lucebianca.co address before launch.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Canonical storefront origin — the backend builds the email-verification
# link with it (must match the frontend's NEXT_PUBLIC_SITE_URL).
SITE_URL=http://localhost:3000

# --- App ---
APP_ENV=local                 # local | production
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
# Allowed origins for CORS (comma-separated), e.g. http://localhost:3000
# The storefront is reachable on both hosts, and the browser calls the API
# (cart validation, placing orders), so both must be allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Luce Bianca API — environment template
# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lucebianca
DB_USER=root
DB_PASS=

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600          # access token lifetime
JWT_REFRESH_TTL_SECONDS=604800 # refresh token lifetime (7 days)

# --- App ---
APP_ENV=local                 # local | production
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
# Allowed origins for CORS (comma-separated), e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
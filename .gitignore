# ============================================================
# Luce Bianca — .gitignore
# ============================================================

# --- Secrets / environment variables (the important part) ---
.env
.env.local
.env.*.local
.env.production
.env.development
/api/config/database.php # if DB credentials are hardcoded here
/api/config/secrets.php

# --- Node.js / Next.js ---
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- PHP / Composer ---
vendor/

# --- Logs ---
*.log
logs/
storage/logs/

# --- Uploaded files (local, not Cloudinary) ---
public/uploads/
uploads/

# --- Database dumps / backups ---
*.sql.bak
*.sqlite
backups/

# --- OS / Editor files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Testing / coverage ---
coverage/
.nyc_output/

# --- Cache ---
.cache/
.eslintcache

# --- Local application runtime state ---
api/storage/cache/
api/storage/rate-limits/
api/storage/logs/

# --- Local agent/editor settings ---
.claude/settings.local.json

# --- Temporary files ---
*.tmp
*.temp
*.cache
*.bak


lucebianca-project-full.md

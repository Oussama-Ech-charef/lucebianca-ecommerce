# Copy to frontend/.env.local for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8090

# Optional: leave empty to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: hero background video + poster (absolute CDN URLs). Leave both
# empty to keep the existing CSS/logo hero. When set, the video autoplays
# muted/looping and the poster is shown for reduced-motion visitors.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_VIDEO_POSTER=
